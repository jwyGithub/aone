#!/usr/bin/env python3
# SMS_SCRIPT 示例（Python）：自定义验证码获取脚本模板
#
# 契约（与 get_code.sh.example 完全相同；login.exp 按 .py 扩展名用 python3 调用本脚本）:
#   - argv[1] = 过滤时间戳（毫秒，图形验证码提交时刻），用于忽略旧短信
#   - stdout 只输出验证码文本（3-8 位字母数字），不要输出其他任何内容
#   - 日志一律写 stderr；获取失败时以非 0 退出码退出（login.exp 会指数退避重试，最多 10 次）
#
# 挂载方式（docker-compose.yml）:
#   volumes:
#     - ./sms:/sms
# 然后在 .env 中设置:
#   SMS_SCRIPT=/sms/get_code.py
import sys


def log(msg):
    print(msg, file=sys.stderr)


def main():
    after_ms = int(sys.argv[1]) if len(sys.argv) > 1 else 0

    # TODO: 在此实现你的取码逻辑，例如轮询你自己的短信网关:
    #   import json, re, urllib.request
    #   with urllib.request.urlopen("https://your-sms-api/latest", timeout=15) as r:
    #       data = json.load(r)
    #   # 忽略图形验证码提交之前的旧短信
    #   if int(data["item"]["createdAt"]) < after_ms:
    #       log("仅有旧短信，忽略"); return 1
    #   m = re.search(r"\d{6}", data["item"]["content"])
    #   code = m.group(0) if m else ""
    code = ""

    if not code:
        log("未能获取验证码")
        return 1

    print(code)  # stdout 仅输出验证码
    return 0


if __name__ == "__main__":
    sys.exit(main())

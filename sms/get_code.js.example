#!/usr/bin/env node
// SMS_SCRIPT 示例（JavaScript / Node）：自定义验证码获取脚本模板
//
// 契约（与 get_code.sh.example 完全相同；login.exp 按 .js 扩展名用 node 调用本脚本）:
//   - process.argv[2] = 过滤时间戳（毫秒，图形验证码提交时刻），用于忽略旧短信
//   - stdout 只输出验证码文本（3-8 位字母数字），不要输出其他任何内容
//   - 日志一律写 stderr（console.error）；失败时以非 0 退出码退出（login.exp 会指数退避重试，最多 10 次）
//
// 挂载方式（docker-compose.yml）:
//   volumes:
//     - ./sms:/sms
// 然后在 .env 中设置:
//   SMS_SCRIPT=/sms/get_code.js

const log = (msg) => process.stderr.write(String(msg) + "\n");

async function main() {
  const afterMs = Number(process.argv[2] || 0);

  // TODO: 在此实现你的取码逻辑，例如轮询你自己的短信网关（Node 18+ 内置 fetch）:
  //   const resp = await fetch("https://your-sms-api/latest");
  //   const data = await resp.json();
  //   // 忽略图形验证码提交之前的旧短信
  //   if (Number(data.item.createdAt) < afterMs) { log("仅有旧短信，忽略"); return 1; }
  //   const m = String(data.item.content).match(/\d{6}/);
  //   const code = m ? m[0] : "";
  const code = "";

  if (!code) {
    log("未能获取验证码");
    return 1;
  }

  process.stdout.write(code); // stdout 仅输出验证码
  return 0;
}

main()
  .then((rc) => process.exit(rc))
  .catch((err) => {
    log("脚本异常: " + (err && err.stack ? err.stack : err));
    process.exit(1);
  });

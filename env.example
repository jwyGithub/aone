# 复制为 .env 并填写真实值
AONE_CORP=your-corp
AONE_USER=13800138000
AONE_PASS=your-password
# 短信验证码脚本（必填）。支持 .sh/.py/.js（按扩展名自动用 bash / python3 / node 调用，无需加可执行位）。契约:
#   参数1=过滤时间戳(毫秒)；stdout 仅输出验证码文本(3-8位字母数字)；日志写 stderr；
#   非0退出视为获取失败(自动重试)。参考示例: sms/get_code.sh.example / get_code.py.example / get_code.js.example
SMS_SCRIPT=/sms/get_code.sh
MIHOMO_PORT=7890
# 自动登录时间段（容器本地时间，已设为 Asia/Shanghai）。格式 HH:MM:SS-HH:MM:SS，分/秒可省略如 8-22、8:30-22:00。
# 仅当检测到下线且当前时间落在该范围内才自动拉起登录；默认 00:00:00-23:59:59（全天）。
# 支持跨午夜，如 22:00:00-06:00:00 表示晚 10 点到次日早 6 点。留空则不限制（全天自动登录）。
AUTO_LOGIN_TIME_RANGE=00:00:00-23:59:59
